  "anchor_blurbs": {
    "umm_aplikasi": "The application hub. Every transaction joins back here via aplikasi_id. No urusan_kod column — JOIN to ind_ursn via ursn_id.",
    "plp_a_pelupusan": "PLP-side container for pelupusan applications (officer-internal). Promoted from plp_p_pelupusan via the AWAM→PLP SPOC integration.",
    "plp_p_pelupusan": "Portal-side container (AWAM/Pra). Holds the applicant's submission before it's accepted by PLP.",
    "umm_a_hkmlk": "Hakmilik (land title) attached to an application. Join-graph centre on the internal side.",
    "umm_p_hkmlk": "Portal-side hakmilik. Promoted to umm_a_hkmlk on PLP submission.",
    "umm_a_permohonan_tnh": "Land-permit application detail. Links umm_a_rizab via a_permohonan_tnh_id.",
    "umm_a_pihak_bkptg": "Party / stakeholder table. The applicant (pemohon) lives here with flag_pemohon='Y'.",
    "ind_ursn": "Urusan (business workflow) reference. All urusan codes (PT, PLPS, PRBB, ...) defined here.",
    "ind_tgsn": "Tugasan (task code) reference. Defines workflow step codes (PYSK, SSK, PSSK, ...).",
    "umm_a_tgsn": "Application's current and past task instances. Joined to ind_tgsn + ind_pejabat + pcp_pengguna for the canonical task-state query.",
    "umm_p_aplikasi": "Portal-side application hub (AWAM). The _p_ counterpart of umm_aplikasi — every Pra-Aplikasi submission joins back here. Gets promoted to umm_aplikasi during SPOC handoff."
  },
