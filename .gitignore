# Basic gitignore
/[Tt]emp/
*.exe

# Claude Code settings
.claude/settings.local.json

# Work project files — sensitive, not for public repo
projects/

# Node dependencies — never commit
node_modules/

# Quest runtime state — ephemeral
quest/active.txt

# Prayer gate runtime files — generated daily
Feature/Time-Based-Aware-System/prayer-cache.json
Feature/Time-Based-Aware-System/prayer-state.json

# Claude Code worktrees — ephemeral, auto-pruned at boot
.claude/worktrees/

# Pre-prune backups — local safety net, not for the repo
backups/

# release-mlk-plp — server endpoints + redmine key + release run-state are internal infra, never for the public repo
domain/release-mlk-plp/servers.local.json
domain/release-mlk-plp/redmine.local.json
domain/release-mlk-plp/state/

# Hook telemetry / fire-logs — ephemeral, rewritten as hooks fire every turn.
# Were tracked by mistake → auto-commit-docs committed+pushed them every turn (junk + cmd flashes).
# Kept tracked (curated data, NOT logs): domain/scan/known-bugs.jsonl · system/slip-counts.jsonl
.claude/hooks/*.log.jsonl
.claude/state/veritas-claim-ledger.jsonl
domain/*/log.jsonl
Feature/Forge-Self-Improvement-System/*-log.jsonl
Feature/Time-Based-Aware-System/reply-log.jsonl
Feature/Time-Based-Aware-System/reply-log-state.json
system/telemetry/hook-fires.jsonl

# 2026-08-05: meta/ is a REGENERATED RUNTIME DIR — ignored WHOLESALE. After the meta/ -> system/
# rename the curated ledgers live in system/; anything that recreates itself under meta/ is churn
# (recent-tool-calls.jsonl, slip-counts.jsonl, telemetry/hook-fires.jsonl). The directory rule
# replaces the per-file entries so a NEW churn file cannot leak through.
meta/

# core/session-trim.js safety backup — regenerated on every --apply, never a deliverable
main/current-session.md.bak

# OneDrive machine-conflict copies — "<name>-<MACHINE>.<ext>" / "<name>-<MACHINE>-<n>.<ext>".
# OneDrive forks a second file whenever two machines write the same path; these are never
# authored content. 2026-08-04: `git add -A system/` swept 53k lines of hook-fires-miyazaki-3/-4
# into a commit. The existing rules only named the exact filename, not the conflict variants.
*-miyazaki.jsonl
*-miyazaki-[0-9].jsonl
*-miyazaki.md
*-miyazaki.js
*-miyazaki.json
*-miyazaki.txt
*-PJNBRidhwan.jsonl
*-PJNBRidhwan.md
*-PJNBRidhwan.json
*-PJNBRidhwan.txt

# Written by RecursiveLoopDetector on EVERY tool call — same churn class as hook-fires.jsonl.
# Moved meta/ -> system/ in a4516fd, so the old ignore rule no longer covered it.
system/recent-tool-calls.jsonl

# Once-per-session state marker written by quest-bounty-verify; regenerated, never content.
domain/quest-bounty/.verify-notified

# compile-gate session-local compile markers — regenerated, never content
.claude/state/compile-ok-*.json

# ── OneDrive/worktree churn fix (2026-08-19, per みや after repeated archive friction) ──
# The repo lives INSIDE OneDrive with ~30 concurrent worktrees. These three files are
# machine-written every boot/session (not hand-authored) and were the perennial "M ..."
# lines blocking every archive + causing lost-block merges. OneDrive already syncs their
# content across machines; git-tracking them on top just creates the conflict. Untracked =
# they never surface at commit again. Durable quest truth = Redmine + per-quest qa_docs;
# active.txt is working memory that "rots" by design (open-quest-surfacer rebuilds from Redmine).
# slip-dashboard.md regenerates via `node core/slips.js dashboard`; watchlist.jsonl is boot telemetry.
quest/active.txt
system/claude-md-watchlist.jsonl
system/slip-dashboard.md
etanah_atlas/lib/__pycache__/
etanah_atlas/config/states.*.json
!etanah_atlas/config/states.example.json
etanah_atlas/checks/

# lib/states.js overlay — hosts/URLs/machine-local roots, never for the public repo (states.local.example.json is the tracked shape)
system/states.local.json

# turn-ledger ephemeral state (retention: regenerate) — 2026-09-07
system/telemetry/current-turn-*.json
system/telemetry/current-turn-*.json.lock
system/telemetry/turn-ledger-state.json
system/telemetry/turns*.jsonl
